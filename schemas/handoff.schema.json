{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Handoff minimum fields",
  "type": "object",
  "required": [
    "objective",
    "current_state",
    "next_actions",
    "acceptance_criteria"
  ],
  "properties": {
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "current_state": {
      "type": "string",
      "minLength": 1
    },
    "next_actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
